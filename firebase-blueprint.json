{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator privilege document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "username", "active", "createdAt", "updatedAt"]
    },
    "House": {
      "title": "House",
      "description": "Residential lot/house unit inside Puerta Cantera Residencial.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "street": { "type": "string", "minLength": 1, "maxLength": 100 },
        "number": { "type": "string", "minLength": 1, "maxLength": 32 },
        "interiorNumber": { "type": "string", "maxLength": 32 },
        "familyName": { "type": "string", "maxLength": 120 },
        "active": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "street", "number", "familyName", "active", "ownerUid", "createdAt", "updatedAt"]
    },
    "Resident": {
      "title": "Resident",
      "description": "Resident account profile with PII (email, phone) and registered automobile QR codes.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "residentKey": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^RES[0-9]+$" },
        "username": { "type": "string", "minLength": 2, "maxLength": 64 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "enum": ["resident", "treasurer", "admin", "guard"] },
        "houseId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "qrCode": { "type": "string", "maxLength": 64 },
        "carCount": { "type": "number" },
        "vehicleQrCodes": { "type": "array", "description": "Up to 10 registered automobiles with QR code, plate, color, and model." },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "residentKey", "username", "name", "email", "role", "active", "qrCode", "carCount", "vehicleQrCodes", "ownerUid", "createdAt", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Maintenance fee payment submitted by a resident for treasury review.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "folio": { "type": "string", "minLength": 2, "maxLength": 32 },
        "houseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "periodLabel": { "type": "string", "minLength": 1, "maxLength": 80 },
        "monthsCovered": { "type": "number" },
        "amountMxn": { "type": "number" },
        "approvedAmountMxn": { "type": "number" },
        "method": { "type": "string", "enum": ["Transferencia SPEI", "Depósito bancario", "Efectivo"] },
        "reference": { "type": "string", "maxLength": 160 },
        "receiptFileName": { "type": "string", "maxLength": 160 },
        "receiptFileSizeBytes": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "reviewNote": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "approved", "adjusted", "rejected"] },
        "createdDate": { "type": "string", "maxLength": 20 },
        "reviewedAt": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "folio", "houseId", "userId", "ownerUid", "userName", "periodLabel", "monthsCovered", "amountMxn", "method", "reference", "status", "createdDate", "createdAt", "updatedAt"]
    },
    "CommunityNotice": {
      "title": "CommunityNotice",
      "description": "Official neighborhood notice published by administration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "body": { "type": "string", "minLength": 5, "maxLength": 3000 },
        "category": { "type": "string", "enum": ["administracion", "mantenimiento", "seguridad", "eventos"] },
        "urgent": { "type": "boolean" },
        "pinned": { "type": "boolean" },
        "sendPush": { "type": "boolean" },
        "createdDate": { "type": "string", "maxLength": 20 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visibility": { "type": "string", "enum": ["community"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "category", "urgent", "pinned", "sendPush", "createdDate", "authorName", "visibility", "createdAt", "updatedAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Maintenance or security incident report submitted by a resident.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "folio": { "type": "string", "minLength": 2, "maxLength": 32 },
        "title": { "type": "string", "minLength": 4, "maxLength": 160 },
        "category": { "type": "string", "enum": ["Alumbrado", "Agua", "Seguridad", "Áreas verdes", "Portón", "Otro"] },
        "description": { "type": "string", "minLength": 6, "maxLength": 2000 },
        "location": { "type": "string", "maxLength": 160 },
        "houseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved"] },
        "createdDate": { "type": "string", "maxLength": 20 },
        "comments": { "type": "array", "description": "Up to 50 follow-up comments." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "folio", "title", "category", "description", "houseId", "ownerUid", "authorName", "status", "createdDate", "comments", "createdAt", "updatedAt"]
    },
    "VisitPass": {
      "title": "VisitPass",
      "description": "Visitor entry QR pass generated for a house.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 4, "maxLength": 32 },
        "houseId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visitorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "plate": { "type": "string", "maxLength": 32 },
        "vehicleModel": { "type": "string", "maxLength": 80 },
        "vehicleColor": { "type": "string", "maxLength": 40 },
        "companions": { "type": "number" },
        "accessType": { "type": "string", "enum": ["single", "multi"] },
        "validFrom": { "type": "string", "maxLength": 20 },
        "validUntil": { "type": "string", "maxLength": 20 },
        "status": { "type": "string", "enum": ["active", "used", "cancelled"] },
        "createdDate": { "type": "string", "maxLength": 20 },
        "entries": { "type": "array", "description": "Up to 50 gate entry records." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "houseId", "ownerUid", "createdByName", "visitorName", "companions", "accessType", "validFrom", "validUntil", "status", "createdDate", "entries", "createdAt", "updatedAt"]
    },
    "FeeScheduleVersion": {
      "title": "FeeScheduleVersion",
      "description": "Neighborhood maintenance fee schedule configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "monthlyMxn": { "type": "number" },
        "semiannualMxn": { "type": "number" },
        "annualMxn": { "type": "number" },
        "dueDay": { "type": "number" },
        "billingStartMonth": { "type": "string", "maxLength": 10 },
        "effectiveFrom": { "type": "string", "maxLength": 20 },
        "createdDate": { "type": "string", "maxLength": 20 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visibility": { "type": "string", "enum": ["community"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "monthlyMxn", "semiannualMxn", "annualMxn", "dueDay", "billingStartMonth", "effectiveFrom", "createdDate", "createdBy", "visibility", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable administrative change history entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "action": { "type": "string", "minLength": 2, "maxLength": 160 },
        "timestampLabel": { "type": "string", "minLength": 2, "maxLength": 64 },
        "beforeSummary": { "type": "string", "maxLength": 600 },
        "afterSummary": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorName", "action", "timestampLabel", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin privilege documents."
    },
    "/houses/{houseId}": {
      "schema": { "$ref": "#/entities/House" },
      "description": "Registered houses in Puerta Cantera Residencial."
    },
    "/residents/{residentId}": {
      "schema": { "$ref": "#/entities/Resident" },
      "description": "Resident accounts, PII, and per-automobile QR records."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Maintenance fee payment records and review statuses."
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/CommunityNotice" },
      "description": "Community announcements published by administration."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/CommunityReport" },
      "description": "Resident incident reports and administrative updates."
    },
    "/visits/{visitId}": {
      "schema": { "$ref": "#/entities/VisitPass" },
      "description": "Visitor QR passes and gate check-in records."
    },
    "/feeHistory/{feeId}": {
      "schema": { "$ref": "#/entities/FeeScheduleVersion" },
      "description": "Maintenance fee schedule versions."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Append-only audit log of administrative actions."
    }
  }
}
